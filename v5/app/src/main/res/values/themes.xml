<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- تم اصلی اپلیکیشن -->
    <style name="Theme.GoldCalculator" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- تم اسپلش -->
    <style name="Theme.GoldCalculator.Splash" parent="Theme.GoldCalculator">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
